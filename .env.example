# Example env for CSS DEV (Postgres). Copy values from machine secrets — do not commit real passwords.
CSS_PORT=9000
CSS_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/app_css?currentSchema=dev
CSS_DB_USER=app_css_dev
CSS_DB_PASSWORD=
CSS_ISSUER=http://127.0.0.1:9000
CSS_SEED_ENABLED=true
CSS_ADMIN_PASSWORD=admin123
CSS_DEMO_PASSWORD=demo123
CSS_SSO_COOKIE_SECURE=false
